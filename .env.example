# Local development only. Copy to .env, then choose your own local password.
POSTGRES_USER=nexaservice_dev
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_DB=nexaservice_dev
POSTGRES_PORT=5432

# Keep this URL aligned with the values above. URL-encode special password characters.
DATABASE_URL="postgresql://nexaservice_dev:replace-with-your-local-password@127.0.0.1:5432/nexaservice_dev?schema=public"

# Generate a long random value for local Auth.js sessions. Use a different value in production.
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# For the one-time local administrator command only; supply your own values.
# NODE_ENV=development
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
